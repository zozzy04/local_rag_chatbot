# ── Ollama ────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral

# ── Qdrant (vector store) ─────────────────────────────────
QDRANT_HOST=http://qdrant:6333
COLLECTION_NAME=rag_collection

# ── Embedding ─────────────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
CHUNK_PRESET=MEDIUM

# ── Dati locali ───────────────────────────────────────────
SOURCE_DIR=./data/input

# ── Database relazionale (§6) ─────────────────────────────
# SQLite (default):
DATABASE_URL=sqlite:///./rag.db
# PostgreSQL (premiato):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ragdb

# ── Gruppo (§7) ───────────────────────────────────────────
GROUP_ID=groupA
GROUP_NAME=Team RAG
GROUP_DESCRIPTION=Corpus su AI, Agents e Cloud
DOMAIN_TAGS=ai,agents,cloud

# ── API federata ──────────────────────────────────────────
# Chiave che i peer devono presentare nell'header X-API-Key
API_KEY=changeme
# Timeout (secondi) per le chiamate ai peer remoti
FEDERATION_TIMEOUT_S=5
